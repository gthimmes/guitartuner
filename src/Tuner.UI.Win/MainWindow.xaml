<Window x:Class="Tuner.UI.Win.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Tuner.UI.Win"
        xmlns:vm="clr-namespace:Tuner.UI.Win.ViewModels"
        xmlns:controls="clr-namespace:Tuner.UI.Win.Controls"
        xmlns:converters="clr-namespace:Tuner.UI.Win.Converters"
        mc:Ignorable="d"
        Title="Guitar Tuner"
        Height="740"
        Width="560"
        MinHeight="640"
        MinWidth="520"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:TunerStateToColorConverter x:Key="StateToColor"/>
        <converters:InverseBoolConverter x:Key="InverseBool"/>
        <converters:AreEqualConverter x:Key="AreEqual"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Guitar Tuner"
                       Style="{StaticResource TitleStyle}"
                       HorizontalAlignment="Center"/>

            <!-- Device Selector -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">
                <TextBlock Text="Input: "
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,5,0"/>
                <ComboBox x:Name="DeviceSelector"
                          ItemsSource="{Binding AudioDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Name"
                          Width="250"/>
            </StackPanel>

            <!-- Mode: listen with the microphone, or play a reference tone -->
            <Border Background="{StaticResource SurfaceBrush}"
                    CornerRadius="6"
                    Padding="3"
                    HorizontalAlignment="Center"
                    Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Microphone"
                                 GroupName="TunerMode"
                                 Style="{StaticResource ModeButtonStyle}"
                                 IsChecked="{Binding IsToneMode, Converter={StaticResource InverseBool}}"/>
                    <RadioButton Content="Reference Tone"
                                 GroupName="TunerMode"
                                 Style="{StaticResource ModeButtonStyle}"
                                 IsChecked="{Binding IsToneMode}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main Tuner Display: string + instruction on the left, vertical gauge on the right -->
        <Grid Grid.Row="1"
              Visibility="{Binding IsToneMode, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <!-- Target String Display -->
                <TextBlock Text="{Binding TargetStringName, FallbackValue='—', TargetNullValue='—'}"
                           Style="{StaticResource StringNameStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding TargetFrequency, StringFormat='{}{0:F2} Hz', TargetNullValue=''}"
                           Style="{StaticResource FrequencyStyle}"
                           HorizontalAlignment="Center"
                           Margin="0,-6,0,18"/>

                <!-- Tuning Instruction - Clear "Tune Up" / "Tune Down" / "In Tune" -->
                <TextBlock Text="{Binding TuningInstruction}"
                           FontSize="28"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="200"
                           Foreground="{Binding State, Converter={StaticResource StateToColor}}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Tuner Indicator -->
            <controls:TunerIndicator Grid.Column="1"
                                     x:Name="TunerIndicator"
                                     CentsOffset="{Binding CentsOffset}"
                                     State="{Binding State}"
                                     Width="280"
                                     Margin="0,0,0,0"/>
        </Grid>

        <!-- Reference Tone Display -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsToneMode, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="🔊"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,4"
                       Foreground="{StaticResource AccentBrush}"
                       Visibility="{Binding IsTonePlaying, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding PlayingString.Name, FallbackValue='—', TargetNullValue='—'}"
                       Style="{StaticResource StringNameStyle}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding PlayingString.Frequency, StringFormat='{}{0:F2} Hz', TargetNullValue=''}"
                       Style="{StaticResource FrequencyStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,-6,0,18"/>
            <TextBlock Text="{Binding ToneInstruction}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="340"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       HorizontalAlignment="Center"/>
            <Button Content="Stop"
                    Command="{Binding StopToneCommand}"
                    Style="{StaticResource StringButtonStyle}"
                    Padding="28,10"
                    HorizontalAlignment="Center"
                    Margin="0,24,0,0"
                    Visibility="{Binding IsTonePlaying, Converter={StaticResource BoolToVisibility}}"/>
        </StackPanel>

        <!-- String Buttons: pick the target (microphone) or play the tone (reference) -->
        <ItemsControl Grid.Row="2"
                      ItemsSource="{Binding StringTargets}"
                      HorizontalAlignment="Center"
                      Margin="0,20,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Name}"
                            Command="{Binding DataContext.SelectStringCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}"
                            Margin="5,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource StringButtonStyle}">
                                <Style.Triggers>
                                    <!-- Highlight the string whose reference tone is playing -->
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <MultiBinding Converter="{StaticResource AreEqual}">
                                                <Binding/>
                                                <Binding Path="DataContext.PlayingString" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                            </MultiBinding>
                                        </DataTrigger.Binding>
                                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <!-- Tuning Selector -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <TextBlock Text="Tuning: "
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,0,5,0"/>
                <ComboBox ItemsSource="{Binding TuningProfiles}"
                          SelectedItem="{Binding SelectedTuning}"
                          DisplayMemberPath="Name"
                          Width="150"/>
            </StackPanel>

            <!-- Signal Level -->
            <Grid HorizontalAlignment="Center" Width="300">
                <ProgressBar Value="{Binding SignalLevel, Mode=OneWay}"
                             Minimum="0" Maximum="1"
                             Height="8"
                             Style="{StaticResource SignalLevelStyle}"/>
            </Grid>

            <!-- Status -->
            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,10,0,0"
                       FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
